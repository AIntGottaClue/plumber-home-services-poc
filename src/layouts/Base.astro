---
import {siteConfig as cfg,mode} from '../data/siteConfig';
import {services,areas} from '../data/content';
import '../styles.css';
const {title,description='Plumbing services, practical problem guides, and contact information in an independent website preview.'}=Astro.props;
const root=import.meta.env.BASE_URL; const link=(path='')=>root+path;
const schema={'@context':'https://schema.org','@type':'WebPage',name:title,description};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, follow"/><meta name="description" content={description}/><title>{title} | {cfg.name} preview</title><meta property="og:title" content={`${title} | ${cfg.name} preview`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body data-mode={mode}><a class="skip" href="#main">Skip to content</a><div class="preview-bar">Independent website preview. <span data-preview-label>Sample business. Not accepting service requests.</span></div>
<header><a class="brand" data-business-name href={link()}>{cfg.name}</a><button class="menu" aria-expanded="false" aria-controls="nav">Menu</button><nav id="nav" aria-label="Main navigation"><a href={link()}>Home</a><details><summary>Services</summary><div class="dropdown"><a href={link('services/')}>All services</a>{services.map(s=><a href={link(`services/${s.slug}/`)}>{s.title}</a>)}</div></details><details><summary>Service Areas</summary><div class="dropdown"><a href={link('service-areas/')}>All service areas</a>{areas.map(a=><a data-area={a.name} href={link(`service-areas/${a.slug}/`)}>{a.name}</a>)}</div></details><a href={link('about/')}>About</a><a href={link('contact/')} class="nav-cta">Contact</a></nav></header>
<div class="data-status" role="status" aria-live="polite" hidden></div><main id="main"><slot/></main>
<footer><div class="footer-top"><div><a class="brand" data-business-name href={link()}>{cfg.name}</a><p>Plumbing information for the Austin area.<br/>Preview content, not a service offer.</p></div><div><a href={link('privacy/')}>Privacy Policy</a><a href={link('terms/')}>Terms of Service</a><a href={link('contact/')}>Contact</a></div></div><p class="fine">Stock photography illustrates plumbing work. It does not show this business, its staff, or a completed job. <a href="https://www.pexels.com/photo/plumber-repairing-pipe-with-wrench-indoors-32588548/">Photo by Bulat843 on Pexels</a>.</p></footer>
<a class="floating" href={link('contact/')} aria-label="Preview contact page">Contact preview ↗</a>
<script is:inline define:vars={{cfg,mode,root}}>
const menu=document.querySelector('.menu');menu.addEventListener('click',()=>{const expanded=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!expanded));document.body.classList.toggle('nav-open',!expanded);document.querySelector('nav').classList.toggle('open',!expanded)});
function bind(b){document.querySelectorAll('[data-business-name]').forEach(el=>el.textContent=b.name);document.querySelectorAll('[data-business-phone]').forEach(el=>el.textContent=b.phone||'No phone configured');document.querySelectorAll('[data-business-source]').forEach(el=>{if(b.sourceUrl){el.href=b.sourceUrl;el.hidden=false}else el.hidden=true});document.querySelectorAll('[data-preview-label]').forEach(el=>el.textContent=b.sample?'Sample business. Not accepting service requests.':'Public business details used for an independent design preview. No affiliation or service requests.');document.title=document.title.replace(cfg.name,b.name);document.querySelector('meta[property="og:title"]').content=document.title;}
bind(cfg);
if(mode==='gviz'){
 const status=document.querySelector('.data-status'); const main=document.querySelector('main');main.hidden=true;status.hidden=false;status.textContent='Loading business preview...';
 document.querySelectorAll('[data-business-name]').forEach(el=>el.textContent='Plumber preview');const slug=new URLSearchParams(location.search).get('business');
 async function load(){if(!slug)throw Error('Choose a business from the demo list.');if(!cfg.sheetId)throw Error('The business sheet is not connected yet.');
 const url=new URL(`https://docs.google.com/spreadsheets/d/${cfg.sheetId}/gviz/tq`);url.searchParams.set('sheet',cfg.sheetName);url.searchParams.set('headers','1');url.searchParams.set('tqx','out:json');
 const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),10000);let text;try{const res=await fetch(url,{signal:controller.signal,credentials:'omit'});if(!res.ok)throw Error('Sheet unavailable');text=await res.text()}finally{clearTimeout(timer)};
 const match=text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*)\);?\s*$/);if(!match)throw Error('Invalid sheet response');const data=JSON.parse(match[1]);if(data.status!=='ok'||!data.table)throw Error('Sheet response error');
 const headers=data.table.cols.map(c=>c.label);const rows=data.table.rows.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r.c[i]?.v??''])));const hits=rows.filter(r=>r.slug===slug&&r.enabled===true);if(hits.length!==1)throw Error('Business not found or duplicate slug');const b=hits[0];if(!b.name||!b.source_url||!/^https:\/\//.test(b.source_url))throw Error('Incomplete business data');
 bind({name:b.name,phone:String(b.phone),sourceUrl:b.source_url,sample:false});const activeAreas=String(b.areas).split('|');const currentArea=location.pathname.match(/service-areas\/([^/]+)\//)?.[1];const areaNames={'austin':'Austin','round-rock':'Round Rock','cedar-park':'Cedar Park'};if(currentArea&&!activeAreas.includes(areaNames[currentArea]))throw Error('Area not configured for business');document.querySelectorAll('[data-area]').forEach(el=>el.hidden=!activeAreas.includes(el.dataset.area));document.querySelectorAll('a').forEach(a=>{const u=new URL(a.href,location.href);if(u.origin===location.origin&&u.pathname.startsWith(root)){u.searchParams.set('business',slug);a.href=u.href}});main.hidden=false;status.hidden=true;
 }
 load().catch(()=>{status.textContent='This business preview could not load. Check the business slug and sheet access, then refresh. No fallback business is shown.';document.querySelectorAll('[data-business-name]').forEach(el=>el.textContent='Plumber preview');});
}
</script></body></html>
